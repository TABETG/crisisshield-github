#!/usr/bin/env bash
# L2-06 : refuse un commit qui contient un secret, avant meme qu'il parte.
# Activation, une fois par clone : git config core.hooksPath .githooks
# Gitleaks tourne dans Docker : rien a installer.
MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd):/repo" -w /repo zricethezav/gitleaks:latest \
  protect --staged --redact --no-banner --exit-code 1
statut=$?
if [ $statut -ne 0 ]; then
  echo
  echo "Commit refuse : Gitleaks a detecte un secret dans les fichiers indexes."
  echo "Retire-le, ou s'il s'agit d'un faux positif documente, ajoute-le a .gitleaksignore."
fi
exit $statut
