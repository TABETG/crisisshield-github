# Copier ce fichier en .env et remplir les valeurs. Le fichier .env est ignore par Git : il ne part jamais.
# Chaque variable est obligatoire : docker compose refuse de demarrer si l'une manque (syntaxe ${VAR:?}).

# --- PostgreSQL ---
POSTGRES_DB=crisisshield_db
# Role proprietaire : reserve aux migrations Flyway et aux sauvegardes
POSTGRES_USER=crisisshield_owner
POSTGRES_PASSWORD=changer-moi-owner
# Role applicatif : lecture et ecriture des donnees, aucun droit sur le schema
DB_APP_USER=crisisshield_app
DB_APP_PASSWORD=changer-moi-app

# --- OpenLDAP ---
LDAP_ADMIN_PASSWORD=changer-moi-ldap

# --- Backend ---
JWT_EXPIRATION=900000
APP_DEV_DATA_ENABLED=true
APP_ASSISTANT_PROVIDER=mock
